# Global .gitignore - OS, editor, and secrets
# Language/framework ignores belong in per-project .gitignore

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── Editors ──────────────────────────────────────────────────────────

# VS Code (keep shared settings)
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/

# Vim / Neovim
*.swp
*.swo

# Cursor
.cursor/

# ── Node.js ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
.pnpm-debug.log*

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage

# ── Environment & Secrets ────────────────────────────────────────────
.env
.env.*
!.env.example
.extra
.envrc
*.pem
*.key
secrets.json

# ── Cloudflare ───────────────────────────────────────────────────────
.wrangler/
.dev.vars

# ── Build & Runtime ──────────────────────────────────────────────────
dist/
coverage/
*.log

# ── Homebrew ─────────────────────────────────────────────────────────
Brewfile.lock.json

# ── Claude ───────────────────────────────────────────────────────────
.claude/
