#!/usr/bin/env zsh
# .functions - Shell functions for agent-first Cloudflare development

# Create directory and cd into it
function mkd() {
    mkdir -p "$@" && cd "$_"
}

# Extract any archive
function extract() {
    if [[ -z "$1" ]] || [[ ! -f "$1" ]]; then
        echo "Usage: extract <archive-file>"
        return 1
    fi

    case "$1" in
        *.tar.bz2)   tar xjf "$1"     ;;
        *.tar.gz)    tar xzf "$1"     ;;
        *.bz2)       bunzip2 "$1"     ;;
        *.gz)        gunzip "$1"      ;;
        *.tar)       tar xf "$1"      ;;
        *.tbz2)      tar xjf "$1"     ;;
        *.tgz)       tar xzf "$1"     ;;
        *.zip)       unzip "$1"       ;;
        *.7z)        7z x "$1"        ;;
        *)           echo "Cannot extract: $1" ;;
    esac
}

# Better tree with sensible defaults
function tre() {
    if command -v eza &>/dev/null; then
        eza --tree --level=3 --ignore-glob=".git|node_modules|.wrangler|dist" "$@"
    else
        ls -la "$@"
    fi
}

# Find processes by name
function psgrep() {
    [[ -z "$1" ]] && { echo "Usage: psgrep <name>"; return 1; }
    ps aux | grep -i "$1" | grep -v grep
}

# Kill processes by name
function killnamed() {
    [[ -z "$1" ]] && { echo "Usage: killnamed <name>"; return 1; }
    pkill -f "$1"
}

# Get external IP
function myip() {
    timeout 10 curl -s https://api.ipify.org 2>/dev/null ||
    timeout 10 curl -s https://icanhazip.com 2>/dev/null | tr -d '\n' ||
    echo "IP lookup unavailable"
}

# Quick HTTP server
function serve() {
    local port="${1:-8000}"
    echo "Serving at http://localhost:${port}"
    python3 -m http.server "$port"
}

# Open in Finder
function o() {
    if [[ $# -eq 0 ]]; then open .; else open "$@"; fi
}

# cd to Finder directory
function cdf() {
    cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" 2>/dev/null || {
        echo "Could not get Finder location"
        return 1
    }
}

# Clean development artifacts in current tree
function cleanup() {
    echo "Cleaning development artifacts..."
    find . -name "node_modules" -type d -prune -exec rm -rf '{}' + 2>/dev/null
    find . -name ".wrangler" -type d -prune -exec rm -rf '{}' + 2>/dev/null
    find . -name "dist" -type d -prune -exec rm -rf '{}' + 2>/dev/null
    find . -name ".DS_Store" -delete 2>/dev/null
    echo "Done."
}

# Generate a secure password
function genpass() {
    local length="${1:-24}"
    openssl rand -base64 "$length" | tr -d "=+/" | cut -c1-"$length"
}
