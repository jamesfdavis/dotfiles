# .gitconfig - Git Configuration
# User-specific settings (name, email) in ~/.extra or ~/.gitconfig.local

[include]
    path = ~/.gitconfig.local

[user]
	name = James Davis
	email = ragingsmurf@gmail.com

# SSH Commit Signing (docs/KEYS.md)
[gpg]
    format = ssh

[gpg "ssh"]
    defaultKeyCommand = ssh-add -L

[tag]
    gpgsign = true

# Core
[init]
    defaultBranch = main

[commit]
    gpgsign = true
    template = ~/.gitmessage

[core]
    editor = nvim
    autocrlf = input
    excludesfile = ~/.gitignore
    attributesfile = ~/.gitattributes
    hooksPath = ~/dotfiles/hooks
    precomposeunicode = true
    untrackedCache = true

# Pull / Push / Fetch
[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true
    pruneTags = true

# Diff & Merge
[diff]
    algorithm = histogram
    colorMoved = default
    tool = nvimdiff

[merge]
    conflictstyle = zdiff3
    tool = nvimdiff

[rerere]
    enabled = true
    autoUpdate = true

# Rebase
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

# Branch
[branch]
    autoSetupMerge = always
    autoSetupRebase = always
    sort = -committerdate

# Aliases
[alias]
    s = status -sb
    ci = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    co = checkout
    cob = checkout -b
    br = branch
    bra = branch -a
    brd = branch -d
    brD = branch -D
    df = diff
    dfs = diff --staged
    lg = log --oneline --graph --decorate -20
    lga = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
    sl = stash list
    sp = stash pop
    unstage = reset HEAD --
    uncommit = reset --soft HEAD~1
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d"
    find = "!f() { git log --oneline --all --grep=\"$1\"; }; f"
    aliases = config --get-regexp alias
    reb = "!f() { git rebase -i HEAD~$1; }; f"
    fixup = "!f() { git commit --fixup=$1; }; f"
    pushf = push --force-with-lease
    remotes = remote -v
    wip = "!git add -A && git commit -m 'WIP'"
    unwip = reset HEAD~1

# Color
[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

# URL Shortcuts
[url "git@github.com:"]
    insteadOf = gh:
    pushInsteadOf = https://github.com/

[url "git@github.com:jamesfdavis/"]
    insteadOf = me:

# GitHub CLI credential helper (uses PATH, works on both Apple Silicon and Intel)
[credential "https://github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

# Performance
[feature]
    manyFiles = true

[pack]
    threads = 0
