# .aliases - Shell shortcuts for agent-first Cloudflare development

# ==============================================================================
# NAVIGATION & FILES
# ==============================================================================

if command -v eza &>/dev/null; then
    alias ls="eza"
    alias ll="eza -la --git"
    alias la="eza -a"
    alias lt="eza --tree --level=2"
else
    alias ll="ls -lah"
    alias la="ls -a"
fi

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias -- -="cd -"

alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias src="cd ~/src"
alias p="cd ~/projects"
alias dot="cd ~/dotfiles"

alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"

if command -v bat &>/dev/null; then
    alias cat="bat --paging=never"
    alias catp="bat"
fi

# ==============================================================================
# GIT
# ==============================================================================

alias g="git"
alias gs="git status"
alias ga="git add"
alias gaa="git add --all"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"

alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"
alias gbD="git branch -D"
alias gco="git checkout"
alias gcob="git checkout -b"
alias gsw="git switch"
alias gswc="git switch -c"

alias gp="git push"
alias gpf="git push --force-with-lease"
alias gl="git pull"
alias gpr="git pull --rebase"

alias gd="git diff"
alias gds="git diff --staged"
alias glog="git log --oneline --graph --decorate -20"
alias gloga="git log --oneline --graph --decorate --all"

alias gst="git stash"
alias gstp="git stash pop"
alias gstl="git stash list"

alias gf="git fetch"
alias gfa="git fetch --all"
alias grb="git rebase"
alias grbi="git rebase -i"

alias glast="git log -1 HEAD --stat"
alias uncommit="git reset --soft HEAD~1"

# lazygit
alias lg="lazygit"

# ==============================================================================
# CLAUDE CODE
# ==============================================================================

alias cc="claude"
alias ccc="claude chat"
alias ccr="claude --resume"
alias cci="claude init"
alias ccv="claude --verbose"

# ==============================================================================
# CLOUDFLARE (WRANGLER)
# ==============================================================================

alias wr="wrangler"
alias wrd="wrangler dev"
alias wrdl="wrangler dev --local"
alias wrp="wrangler deploy"
alias wrl="wrangler tail"
alias wrd1="wrangler d1"
alias wrkv="wrangler kv"
alias wrr2="wrangler r2"
alias wrpages="wrangler pages"
alias wrsec="wrangler secret"

# ==============================================================================
# GITHUB CLI
# ==============================================================================

alias ghpr="gh pr create"
alias ghprl="gh pr list"
alias ghprv="gh pr view"
alias ghprw="gh pr view --web"
alias ghprc="gh pr checkout"
alias ghprm="gh pr merge"

alias ghis="gh issue create"
alias ghisl="gh issue list"
alias ghisv="gh issue view"

alias ghrepo="gh repo view --web"
alias ghbrowse="gh browse"

# ==============================================================================
# NODE / NPM
# ==============================================================================

alias ni="npm install"
alias nid="npm install --save-dev"
alias nr="npm run"
alias nrd="npm run dev"
alias nrb="npm run build"
alias nrt="npm run test"

# ==============================================================================
# DOCKER (via Colima)
# ==============================================================================

alias dc="docker compose"
alias dcu="docker compose up -d"
alias dcd="docker compose down"
alias dcl="docker compose logs -f"
alias dps="docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'"

# ==============================================================================
# EDITORS & SYSTEM
# ==============================================================================

alias v="nvim"
alias c="code"
alias c.="code ."

alias ports="lsof -i -P -n | grep LISTEN"
alias kill8787="lsof -ti:8787 | xargs kill -9"

alias ip="curl -s ifconfig.me"
alias localip="ipconfig getifaddr en0"

alias reload="exec ${SHELL} -l"
alias rl="reload"
alias cls="clear"

alias brewup="brew update && brew upgrade && brew cleanup"

alias grep="grep --color=auto"
alias du="du -h"
alias df="df -h"

# macOS
if [[ "$OSTYPE" == "darwin"* ]]; then
    alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
    alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
    alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
fi
